"use client";

// Rename this file to client.ts after installing the Firebase SDK:
//   npm --prefix web install firebase
//
// This is an example file and is intentionally excluded from TypeScript builds.

import { getApp, getApps, initializeApp, type FirebaseApp } from "firebase/app";
import {
  connectAuthEmulator,
  getAuth,
  type Auth,
} from "firebase/auth";
import {
  connectFirestoreEmulator,
  getFirestore,
  type Firestore,
} from "firebase/firestore";
import { getFirebasePublicConfig } from "./config";

export type FirebaseClientServices = {
  app: FirebaseApp;
  auth: Auth;
  db: Firestore;
};

let cached: FirebaseClientServices | undefined;

export function getFirebaseClient(): FirebaseClientServices {
  if (cached) return cached;

  const config = getFirebasePublicConfig();
  if (!config) {
    throw new Error(
      "Firebase is not configured. Copy web/.env.example to web/.env.local and fill in the Firebase web-app values first.",
    );
  }

  const app = getApps().length ? getApp() : initializeApp(config);
  const auth = getAuth(app);
  const db = getFirestore(app);

  // Enable emulators only by explicit opt-in. The global marker prevents
  // duplicate emulator connections during client-side hot reloads.
  const globalForFirebase = globalThis as typeof globalThis & {
    __mclFirebaseEmulatorsConnected?: boolean;
  };
  if (
    process.env.NEXT_PUBLIC_USE_FIREBASE_EMULATORS === "true" &&
    !globalForFirebase.__mclFirebaseEmulatorsConnected
  ) {
    connectAuthEmulator(auth, "http://127.0.0.1:9099", { disableWarnings: true });
    connectFirestoreEmulator(db, "127.0.0.1", 8080);
    globalForFirebase.__mclFirebaseEmulatorsConnected = true;
  }

  cached = { app, auth, db };
  return cached;
}
