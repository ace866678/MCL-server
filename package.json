{
  "name": "cloud-vm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "//": "Vercel's repository-root build installs this small Next.js shim at the root for framework detection, then installs the locked panel dependencies in web/. The actual panel build runs inside web/.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "typecheck": "npm --prefix web run typecheck",
    "test:agent": "python3 agent/tests/test_agent.py",
    "test:bridge": "python3 bridge/test_bridge.py",
    "test:protocol": "python3 agent/tests/stub_agent_api.py --self-test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
