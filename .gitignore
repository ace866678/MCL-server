# Runtime server directory: worlds, player data, logs, generated configs.
/server/

# Backups produced by `mc backup`.
/backups/

# Local overrides for heap size and JVM flags. Never commit this — it is
# per-machine.
/server.env

# Console FIFO and pid file, both live inside /server but are called out here
# so an accidental `git add -f` is obvious.
*.pid
*.fifo

*.log
.DS_Store

# Python bytecode from running the bridge, the agent and their tests.
__pycache__/
*.py[cod]

# ---- Agent ------------------------------------------------------------------
#
# agent/agent.json holds the one-time agent token. It is a credential that grants
# control of the machine the agent runs on, so it is never committed -- not even
# encrypted. The dashboard shows it once; copy it into this file locally.
/agent/agent.json

# Everything the agent creates at runtime, per server: worlds, player data,
# plugin jars, generated configs, logs, generated RCON passwords and the
# agent's own log files.
/agent/data/
/agent/logs/

# A tunnel provider's claim token, if an operator keeps one here rather than in
# agent.json. Belt and braces: agent.json is ignored, but so is a stray copy.
*.claim-token
